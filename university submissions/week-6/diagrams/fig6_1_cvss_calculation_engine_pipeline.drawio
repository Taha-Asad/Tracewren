  <diagram id="fig6_1_cvss_calculation_engine_pipeline" name="CVSS Calculation Engine Pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#000000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
