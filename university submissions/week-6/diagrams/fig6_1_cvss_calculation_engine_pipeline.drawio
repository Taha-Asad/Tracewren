        <!-- Mathematical Sub-Scores Container -->
        <mxCell id="box_math" value="&lt;b&gt;Mathematical Sub-Score Evaluation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.5;strokeDashed=1;fontColor=#ffffff;align=center;verticalAlign=top;spacingTop=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="900" height="150" as="geometry" />
        </mxCell>
        <mxCell id="math_iss" value="&lt;b&gt;1. Impact Sub-Score (ISS)&lt;/b&gt;&lt;br/&gt;ISS = 1 - [(1 - C) × (1 - I) × (1 - A)]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.2;fontColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="280" y="445" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="math_imp" value="&lt;b&gt;2. Scope-Dependent Impact&lt;/b&gt;&lt;br/&gt;Unchanged: 6.42 × ISS&lt;br/&gt;Changed: 7.52×(ISS-0.029) - 3.25×(ISS-0.02)^15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.2;fontColor=#ffffff;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
