          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Metric Tokenizer -->
        <mxCell id="box_tok" value="&lt;b&gt;Vector Tokenizer &amp;amp; Weight Lookup&lt;/b&gt;&lt;br/&gt;Maps metric keys to official FIRST.org floating-point constants" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="475" y="300" width="450" height="60" as="geometry" />
