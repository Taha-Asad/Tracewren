        <mxCell id="title_1" value="&lt;h1 style=&quot;color:#ffffff;font-family:Helvetica;margin:0;font-weight:normal;&quot;&gt;BugBountyTrack — FIRST.org CVSS 3.1 Calculation Engine Pipeline&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="1200" height="40" as="geometry" />
        </mxCell>
        <!-- Vector Ingestion -->
        <mxCell id="box_vec" value="&lt;b&gt;Raw Vector String Ingestion&lt;/b&gt;&lt;br/&gt;e.g., CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="400" height="60" as="geometry" />
        </mxCell>
        <!-- Regex Validation -->
        <mxCell id="box_val" value="&lt;b&gt;Strict Grammar Validation Pipe&lt;/b&gt;&lt;br/&gt;Regex: ^CVSS:3\.1/AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]$" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
