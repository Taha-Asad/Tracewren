        <mxCell id="e_val_tok" value="Valid Vector" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;labelBackgroundColor=#000000;" edge="1" source="box_val" target="box_tok" parent="1">
