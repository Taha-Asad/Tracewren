          <mxGeometry x="200" y="430" width="1050" height="40" as="geometry" />
        </mxCell>
        <mxCell id="db_schema" value="&lt;b&gt;Schema: bbt_core (3NF Relational Model)&lt;/b&gt;&lt;br/&gt;15 Tables: organizations, users, user_memberships, bounty_programs, reports, sessions, audit_events..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.2;fontColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="200" y="490" width="1050" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db_rls" value="&lt;b&gt;Kernel Row-Level Security (RLS) Isolation Engine&lt;/b&gt;&lt;br/&gt;Enforced via bbt_app role (NOSUPERUSER, NOBYPASSRLS) | org_id Tenant Partitioning" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.8;fontColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
