          <mxGeometry x="850" y="110" width="350" height="60" as="geometry" />
        </mxCell>
        <!-- Routing Gateway -->
        <mxCell id="box_pooler" value="&lt;b&gt;PgBouncer Connection Pooler (Port 5432)&lt;/b&gt;&lt;br/&gt;DATABASE_URL: Transaction Mode | connect_timeout=15s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.8;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="200" y="240" width="450" height="70" as="geometry" />
        </mxCell>
        <mxCell id="box_direct" value="&lt;b&gt;Dedicated Compute Direct Session&lt;/b&gt;&lt;br/&gt;DIRECT_DATABASE_URL: Unpooled TCP Session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=1.8;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
